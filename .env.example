# =============================================================================
# Capistra - example environment configuration
# =============================================================================
# Copy this file to `.env` and fill in your local values.
# NEVER commit the real `.env` file - it is git-ignored.
# =============================================================================

# ---- Application --------------------------------------------------------
APP_NAME="Capistra"
APP_ENV=local
APP_DEBUG=false
APP_URL="http://localhost/capistra"
APP_TIMEZONE="Asia/Kathmandu"

# Base currency used for formatting throughout the UI (ISO 4217).
APP_BASE_CURRENCY="NPR"

# ---- Database -----------------------------------------------------------
# Canonical database name for the public project.
DB_NAME=capistra
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---- Mail (optional - only used for OTP / notifications if enabled) ------
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_ENCRYPTION=

# ---- Security -----------------------------------------------------------
# Long random string used for CSRF signing / session hardening.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Set to true only on HTTPS deployments.
SESSION_SECURE_COOKIE=false

# ---- Demo account (documented, fictional, local-only) -------------------
# The password hash for the demo account is stored in database/demo_seed.sql.
# The plaintext below is for the local demo account ONLY.
DEMO_USERNAME=demo_admin
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=Demo@12345
